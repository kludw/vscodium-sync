{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"types": ["vscode", "node"],
		"rootDir": "./src",
		"paths": {
			"@services/*": ["./src/services/*"],
			"@util/*": ["./src/util/*"]
		},
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src"]
}
